# Base URL of the Discord bot HTTP API (no trailing slash)
# Falls back to https://azcicro5jq.apps.bot-hosting.cloud
NEXT_PUBLIC_BOT_API_URL=https://ixhez10d3y.apps.bot-hosting.cloud

# Shared secret for the protected bot endpoints (server-side only, never NEXT_PUBLIC_)
BOT_API_SECRET=

# Discord login (Developer Portal -> OAuth2).
# Add this Redirect URI there: <NEXTAUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Shown on /privacy and /terms
OPERATOR_NAME=
OPERATOR_COUNTRY=
CONTACT_EMAIL=